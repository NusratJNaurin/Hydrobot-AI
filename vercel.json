{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/farm-assistant.js": { "maxDuration": 30 },
    "api/config.js": { "maxDuration": 10 },
    "api/auth-signup-check.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/js/config.js", "destination": "/api/config" },
    { "source": "/api/auth/signup-check", "destination": "/api/auth-signup-check" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}